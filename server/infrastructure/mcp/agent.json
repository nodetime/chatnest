{
  "maxSteps": null,
  "timeoutMs": 900000,
  "toolTimeoutMs": 30000,
  "maxOutputTokens": 8000,
  "servers": [
    {
      "id": "exa",
      "enabled": true,
      "name": "Exa 网页搜索",
      "url": "https://mcp.exa.ai/mcp",
      "headers": {},
      "allowedTools": ["web_search_exa", "web_fetch_exa"],
      "autoApproveTools": ["web_search_exa", "web_fetch_exa"]
    },
    {
      "id": "tavily",
      "enabled": false,
      "name": "Tavily Search",
      "url": "https://mcp.tavily.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${TAVILY_API_KEY}"
      },
      "allowedTools": [
        "tavily_search",
        "tavily_extract",
        "tavily-search",
        "tavily-extract"
      ],
      "autoApproveTools": [
        "tavily_search",
        "tavily_extract",
        "tavily-search",
        "tavily-extract"
      ]
    },
    {
      "id": "porta",
      "enabled": true,
      "name": "1688 商品查询",
      "url": "${PORTA_MCP_URL}",
      "headers": {
        "Authorization": "Bearer ${PORTA_SERVICE_TOKEN}"
      },
      "allowedTools": ["native_alibaba1688_product_find_product"],
      "autoApproveTools": ["native_alibaba1688_product_find_product"]
    }
  ]
}
