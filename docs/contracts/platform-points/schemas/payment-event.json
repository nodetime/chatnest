{
  "$id": "platform-points/payment-event",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["provider", "eventId", "eventType"],
  "additionalProperties": false,
  "description": "Validated JSON-safe core facts produced by the sole provider normalizer. points is exact signed decimal text; runtime converts only this field to bigint pointUnits. Not a raw provider webhook or proof of provider settlement.",
  "properties": {
    "provider": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?![\\s\\S]*[\\u0000\\uD800-\\uDFFF])(?=[\\s\\S]*\\S)[\\s\\S]+$"
    },
    "eventId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?![\\s\\S]*[\\u0000\\uD800-\\uDFFF])(?=[\\s\\S]*\\S)[\\s\\S]+$"
    },
    "eventType": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?![\\s\\S]*[\\u0000\\uD800-\\uDFFF])(?=[\\s\\S]*\\S)[\\s\\S]+$"
    },
    "amountCents": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "userId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "organizationId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "checkoutId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?![\\s\\S]*[\\u0000\\uD800-\\uDFFF])(?=[\\s\\S]*\\S)[\\s\\S]+$"
    },
    "refundId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?![\\s\\S]*[\\u0000\\uD800-\\uDFFF])(?=[\\s\\S]*\\S)[\\s\\S]+$"
    },
    "providerPaymentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?![\\s\\S]*[\\u0000\\uD800-\\uDFFF])(?=[\\s\\S]*\\S)[\\s\\S]+$"
    },
    "providerAccount": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?![\\s\\S]*[\\u0000\\uD800-\\uDFFF])(?=[\\s\\S]*\\S)[\\s\\S]+$"
    },
    "signature": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^(?![\\s\\S]*[\\u0000\\uD800-\\uDFFF])(?=[\\s\\S]*\\S)[\\s\\S]+$"
    },
    "points": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,18})(?:\\.[0-9]{1,6})?$|^-(?:0\\.[0-9]{1,6}|[1-9][0-9]{0,18}(?:\\.[0-9]{1,6})?)$"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$"
    },
    "subscription": {
      "$ref": "#/$defs/PaymentSubscriptionFacts"
    },
    "refund": {
      "type": "object",
      "required": ["chargeId", "state", "amountMinor"],
      "additionalProperties": false,
      "properties": {
        "chargeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^(?![\\s\\S]*[\\u0000\\uD800-\\uDFFF])(?=[\\s\\S]*\\S)[\\s\\S]+$"
        },
        "state": {
          "type": "string",
          "enum": [
            "pending",
            "requires_action",
            "succeeded",
            "failed",
            "canceled"
          ]
        },
        "amountMinor": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    }
  },
  "$defs": {
    "PaymentSubscriptionFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subscriptionId", "planSlug", "status"],
      "properties": {
        "subscriptionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?![\\s\\S]*[\\u0000\\uD800-\\uDFFF])(?=[\\s\\S]*\\S)[\\s\\S]+$"
        },
        "planSlug": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?![\\s\\S]*[\\u0000\\uD800-\\uDFFF])(?=[\\s\\S]*\\S)[\\s\\S]+$"
        },
        "status": {
          "type": "string",
          "enum": ["trialing", "active", "past_due", "canceled", "incomplete"]
        },
        "currentPeriodStart": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "currentPeriodEnd": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "cancelAtPeriodEnd": {
          "type": "boolean"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
