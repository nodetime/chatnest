# 随机密钥生成:https://generate-secret.vercel.app/32 或 `openssl rand -base64 32`
AUTH_SECRET=****

# 显式 pnpm db:seed 的初始管理员种子配置，适用于任意 NODE_ENV 与 POSTGRES_URL。
# dev:up 调用同一种子；应用启动/请求不隐式创建。部署时按需修改默认密码。
# 邮箱为 <DEV_ADMIN_USERNAME>@chatnest.local；仅 development 额外支持用户名登录。
DEV_ADMIN_USERNAME=admin
DEV_ADMIN_PASSWORD=123456

# 仅为初始兜底:数据库迁移完成后,在 /admin/models 配置模型。
# connected billing/admin 以 Payload staff identity/capability 为准；下方 allowlist 仅供 standalone 与尚未迁移的 MCP/上传管理入口。
# 托管设置对新请求优先生效;严禁复制 Anthropic 凭据到此。
# 直连 OpenAI 或 OpenAI 兼容接口(无需 Vercel Gateway key)。
# Multi-tenant organization UI is opt-in; personal billing is the default.
ACCOUNT_ORGANIZATIONS_ENABLED=0
MODEL_PROVIDER=openai
OPENAI_API_KEY=
# API 基础地址,不是完整的 /chat/completions 或 /responses 端点。
OPENAI_BASE_URL=https://api.openai.com/v1
# 使用端点实际提供的精确模型 ID。
OPENAI_MODEL=gpt-4.1
# chat(默认):Chat Completions 协议。responses:仅端点支持时使用。
OPENAI_API_MODE=chat
# 声明所选模型的能力;tools 需要端点真实支持工具调用。
OPENAI_MODEL_TOOLS=1
OPENAI_MODEL_VISION=0

# 备选:设 MODEL_PROVIDER=gateway 并使用 Vercel AI Gateway 的 key/OIDC。
# OpenAI 密钥无法通过 Vercel Gateway 鉴权。
AI_GATEWAY_API_KEY=

# 私有本地上传:生产环境必须使用绝对持久目录。
# 开发默认用被忽略的 .data/private-uploads。严禁放在 public/ 下。
# UPLOAD_STORAGE_DIR=/srv/chatnest/private-uploads
# 字节为单位的配额上限(最小 5 MiB,最大 1 TiB)。
UPLOAD_USER_QUOTA_BYTES=104857600
UPLOAD_TOTAL_QUOTA_BYTES=1073741824
# 先跑数据库迁移,再到 /admin/storage 测试并启用。
# 该驱动面向长驻自托管 Node 服务,不适用于临时/无服务磁盘。

# 生产运行身份：PG16 专属库、直接 LOGIN、非 owner，仅业务 DML。
# 迁移使用单独 deploy/migration.env.example，不向 app 传 MIGRATION_POSTGRES_URL/POSTGRES_PASSWORD。
# 每次迁移后由 DBA 应用 deploy/runtime-role.sql，再以运行环境检查 /api/health/ready。
POSTGRES_URL=****

# https://vercel.com/docs/redis
REDIS_URL=****

# 演示启用 Porta 百炼1688 和免Key Exa；Tavily 在 agent.json 中 enabled=false。
TAVILY_API_KEY=

# 可选 Porta HTTP MCP。两个值必须同时提供,否则整项跳过。
# token 是 Porta 的服务 token；百炼密钥只保留在 Porta 服务端。
PORTA_MCP_URL=
PORTA_SERVICE_TOKEN=
# 显式的仅本地联调开关:还需 NODE_ENV=development 或 test。
# 仅允许 localhost、127.0.0.1 或 [::1] 使用 HTTP;生产仍强制 HTTPS。
# AGENT_MCP_ALLOW_LOOPBACK_HTTP=1
# PORTA_MCP_URL=http://127.0.0.1:3334/mcp

# 生产化积分平台连接与 Worker 调度。
PLATFORM_MODE=standalone
PLATFORM_BASE_URL=https://platform.example.com
PLATFORM_SERVICE_TOKEN=
PLATFORM_USER_ISSUER=chatnest
# 仅由调度器调用 /api/internal/billing/*，不要暴露给浏览器。
CHATNEST_CONTROL_TOKEN=
CHATNEST_BASE_URL=https://chat.example.com
# scripts/production-acceptance.mjs 访问 Payload internal admin contract 的映射身份；不是用户 token。
PLATFORM_ADMIN_ISSUER=chatnest
PLATFORM_ADMIN_SUBJECT=ADMIN_SUBJECT
CHATNEST_SETTLEMENT_BATCH_SIZE=25
CHATNEST_SETTLEMENT_LEASE_SECONDS=300
CHATNEST_SETTLEMENT_MAX_ATTEMPTS=8
# CHATNEST_WORKER_TIMEOUT_MS=30000
# Connected payment inbox recovery batch size.
# PAYMENT_RECONCILE_BATCH_SIZE=25
# 由支付编排层提供的结算入口；Webhook 仍由 Payload 接收并幂等入账。
PAYMENT_CHECKOUT_BASE_URL=https://billing.example.com/checkout
POINT_SCALE=1000000

# 可选的部署侧配置路径(绝不接受聊天消息传入)。
# AGENT_CONFIG_PATH=./config/agent.json

# 仅限本地长驻 Node 运行时。公开/无服务部署保持禁用。
# 安装钉定的 Chromium:corepack pnpm exec playwright install chromium
BROWSER_RUNTIME=disabled

# 可视化 HTTP MCP 管理(一个部署即一个共享工作区)。
# 推荐的平台管理员白名单:精确的正式用户 UUID,逗号分隔。
# 不支持邮箱/游客/首用户兜底。取消注释并替换为真实账号 UUID。
# PLATFORM_ADMIN_USER_IDS=ADMIN_UUID
# standalone 或未迁移的 MCP/上传管理入口使用精确 UUID allowlist；connected billing/admin 由 Payload capability probe 决定。
# 仅当 PLATFORM_ADMIN_USER_IDS 未设置时，才回退识别旧的 MCP_ADMIN_USER_IDS。
# 显式设置 PLATFORM_ADMIN_USER_IDS=(空)会禁用本地 legacy 入口，不影响 Payload staff mapping。
# 模型与 MCP 托管设置共用此密钥，启用时必须同时配置非空的精确信任来源。
# 仅设密钥而 MCP_ALLOWED_ORIGINS 为空会导致配置校验失败，聊天可能在模型调用前中止。
# 生成一次:openssl rand -base64 32。务必与加密数据库一起安全备份。
# 仅修改该值不会轮换已加密存储的存量设置。
MCP_SETTINGS_ENCRYPTION_KEY=
# 仅信任精确 origin,逗号分隔;禁用通配符、路径与尾斜杠。
# 按实际启用服务配置，例如 https://mcp.exa.ai；多个来源用逗号分隔。
MCP_ALLOWED_ORIGINS=

# 仅供自动化单元测试的开发回环模型端点;生产环境绝不开启。
# MODEL_ALLOW_LOOPBACK_HTTP=1

# 日志:等级(info 默认);设 LOG_FILE_DIR 开启 JSONL 文件双写(10M/每日轮转,保留 14 份),空=仅 stdout
# LOG_LEVEL=info
# LOG_FILE_DIR=

# 可选:透明代理 Fake-IP 场景的精确域名→真实公网 IP JSON；保留 HTTPS/TLS 校验。
# 示例只表示格式，必须替换为目标服务经独立确认的真实公网地址。
# MODEL_DNS_OVERRIDES={"gateway.example":["1.1.1.1"]}
# 仅在本机 Fake-IP 代理影响候选图片解析时配置精确域名与已核实公网IP；仍校验TLS且拒绝私网。
# IMAGE_DNS_OVERRIDES={"images.example.com":["1.1.1.1"]}
ACCOUNT_DELETION_RETENTION_DAYS=30
ACCOUNT_RETENTION_BATCH_SIZE=25
# Optional account deletion notification sink; payload contains the address and tombstone event only.
# ACCOUNT_DELETION_NOTIFICATION_WEBHOOK_URL=https://notify.example.com/account-deletion
# ACCOUNT_DELETION_NOTIFICATION_WEBHOOK_TOKEN=TOKEN
ACCOUNT_DELETION_NOTIFICATION_BATCH_SIZE=25

# 内部通用命令执行服务。token 与 execution.env 相同，随机生成，不入 Git。
# 开发由 pnpm execution:up 写入私密 .env.local；Compose 内网使用 http://execution:8080。
EXECUTION_SERVICE_URL=http://execution:8080
EXECUTION_SERVICE_TOKEN=
