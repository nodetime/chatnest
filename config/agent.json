{
  "maxSteps": 12,
  "timeoutMs": 240000,
  "toolTimeoutMs": 30000,
  "maxOutputTokens": 8000,
  "servers": [
    {
      "id": "exa",
      "name": "Exa 网页搜索",
      "url": "https://mcp.exa.ai/mcp",
      "headers": {},
      "allowedTools": ["web_search_exa", "web_fetch_exa"],
      "autoApproveTools": ["web_search_exa", "web_fetch_exa"]
    },
    {
      "id": "tavily",
      "name": "Tavily Search",
      "url": "https://mcp.tavily.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${TAVILY_API_KEY}"
      },
      "allowedTools": [
        "tavily_search",
        "tavily_extract",
        "tavily-search",
        "tavily-extract"
      ],
      "autoApproveTools": [
        "tavily_search",
        "tavily_extract",
        "tavily-search",
        "tavily-extract"
      ]
    },
    {
      "id": "porta",
      "name": "Porta 1688 数据查询",
      "url": "${PORTA_MCP_URL}",
      "headers": {
        "Authorization": "Bearer ${PORTA_SERVICE_TOKEN}"
      },
      "allowedTools": [
        "onebound_1688_item_search",
        "onebound_1688_item_get",
        "onebound_1688_item_get_shop",
        "onebound_1688_item_get_company",
        "onebound_1688_upload_img",
        "onebound_1688_item_search_img"
      ],
      "autoApproveTools": []
    }
  ]
}
