# generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=****

# Direct OpenAI or an OpenAI-compatible API (no Vercel Gateway key needed).
MODEL_PROVIDER=openai
OPENAI_API_KEY=
# API base URL, not the full /chat/completions or /responses endpoint.
OPENAI_BASE_URL=https://api.openai.com/v1
# Use the exact model ID offered by your endpoint.
OPENAI_MODEL=gpt-4.1
# chat (default): Chat Completions. responses: only if the endpoint supports it.
OPENAI_API_MODE=chat
# Declare your chosen model's capabilities; tools require actual tool-call support.
OPENAI_MODEL_TOOLS=1
OPENAI_MODEL_VISION=0

# Alternative: set MODEL_PROVIDER=gateway and use a Vercel AI Gateway key/OIDC.
# OpenAI keys cannot authenticate to the Vercel Gateway.
AI_GATEWAY_API_KEY=

# https://vercel.com/docs/vercel-blob
BLOB_READ_WRITE_TOKEN=****

# https://vercel.com/docs/postgres
POSTGRES_URL=****

# https://vercel.com/docs/redis
REDIS_URL=****

# Default Exa search/fetch MCP requires no key; free use is rate-limited.
# Optional additional provider: Tavily MCP, enabled only when its key is present.
TAVILY_API_KEY=

# Optional Porta HTTP MCP. Both values are required; otherwise it is skipped.
# The token is Porta's service token, NOT a OneBound provider key/secret.
# Keep OneBound credentials only on the Porta server.
PORTA_MCP_URL=
PORTA_SERVICE_TOKEN=
# Explicit local-only opt-in: also requires NODE_ENV=development or test.
# Allows HTTP only for localhost, 127.0.0.1 or [::1]; production still requires HTTPS.
# AGENT_MCP_ALLOW_LOOPBACK_HTTP=1
# PORTA_MCP_URL=http://127.0.0.1:3334/mcp

# Optional deployment-controlled config path (never supplied by a chat message).
# AGENT_CONFIG_PATH=./config/agent.json

# Local long-lived Node runtime only. Keep disabled on public/serverless deployments.
# Install the pinned Chromium: corepack pnpm exec playwright install chromium
BROWSER_RUNTIME=disabled

# Optional visual HTTP MCP management (one deployment = one shared workspace).
# Exact immutable regular-user UUIDs, comma-separated; no email/guest/first-user fallback.
MCP_ADMIN_USER_IDS=
# Generate once: openssl rand -base64 32. Back up securely with the encrypted DB.
# Changing this value alone does NOT rotate existing encrypted settings.
MCP_SETTINGS_ENCRYPTION_KEY=
# Trusted exact origins only, comma-separated; no wildcard, paths, or trailing slash.
# Example: https://mcp.example.org,https://porta.example.org
MCP_ALLOWED_ORIGINS=
