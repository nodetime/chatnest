{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/next",
    "ultracite/biome/react"
  ],
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "files": {
    "includes": [
      "**/*",
      "!.ccode",
      "!app/_components/ai-elements",
      "!app/_components/elements",
      "!app/_components/ui",
      "!app/_lib/utils.ts",
      "!app/_hooks/use-mobile.ts"
    ]
  },
  "linter": {
    "rules": {
      "suspicious": {
        "noExplicitAny": "off",
        "noUnknownAtRules": "off",
        "noConsole": "off",
        "noBitwiseOperators": "off",
        "noUnnecessaryConditions": "off"
      },
      "style": {
        "noMagicNumbers": "off",
        "noNestedTernary": "off",
        "useConsistentTypeDefinitions": "off"
      },
      "nursery": {
        "useSortedClasses": "off"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": "off",
        "useSimplifiedLogicExpression": "off"
      },
      "a11y": {
        "noSvgWithoutTitle": "off"
      },
      "correctness": {
        "useUniqueElementIds": "off",
        "useImageSize": "off"
      },
      "performance": {
        "noBarrelFile": "off",
        "useTopLevelRegex": "off"
      }
    }
  },
  // DDD 边界强制(规划第七节,探针验证后上墙):
  // 坑:同一条规则被多个 override 匹配同一文件时,后写的整体替换先写的——
  // 因此 R2(server/**) 放最前,domain 合体(R1+R2+反向禁令)放最后,靠覆盖顺序取胜。
  // P7 后域模块(agent/ai/uploads/artifacts/admin/skills/config)全部消亡,反向禁令退役;
  // 新增 server/ 顶层目录时必须同步本文件与各层 README,防止层次倒置回潮。
  "overrides": [
    {
      // Figma 原始导出须保持字节哈希；仅关闭这两个资产的格式化与属性重排。
      "includes": ["public/brand/radar.svg", "app/icon.svg"],
      "formatter": { "enabled": false },
      "assist": { "enabled": false }
    },
    {
      "includes": ["server/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/app/**",
                      "next/server",
                      "next/headers",
                      "next/navigation"
                    ],
                    "message": "R2: server 不认识 HTTP 与前端;请求上下文应作为参数传入"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["app/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/server/infrastructure/**"],
                    "message": "R3: 平台层只能调 application 的 usecase,不得直接访问持久化"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["app/_components/**", "app/_hooks/**", "app/_lib/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/server/application/**",
                      "@/server/infrastructure/**",
                      "@/server/composition"
                    ],
                    "message": "R4: UI 层只能 import server/domain 的类型,不得调用服务端逻辑"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["server/domain/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/server/application/**",
                      "@/server/infrastructure/**",
                      "@/app/**"
                    ],
                    "message": "R1: domain 只放类型 + 仓储接口 + 纯函数,不得依赖外层"
                  },
                  {
                    "group": ["../../**"],
                    "message": "R1: 跨层相对导入禁止,一律用 @/ 别名"
                  },
                  {
                    "group": [
                      "@/app/**",
                      "next/server",
                      "next/headers",
                      "next/navigation"
                    ],
                    "message": "R2: server 不认识 HTTP 与前端;请求上下文应作为参数传入"
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
